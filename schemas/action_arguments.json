{
  "prepare_config": {
    "$defs": {
      "JsonValue": {}
    },
    "additionalProperties": false,
    "properties": {
      "notebook": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Notebook",
        "type": "string"
      },
      "configfile": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Configfile",
        "type": "string"
      },
      "workdir": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Workdir",
        "type": "string"
      },
      "parameters": {
        "additionalProperties": {
          "$ref": "#/$defs/JsonValue"
        },
        "title": "Parameters",
        "type": "object"
      }
    },
    "required": [
      "notebook",
      "configfile",
      "workdir"
    ],
    "title": "PrepareConfig",
    "type": "object"
  },
  "check_readiness": {
    "additionalProperties": false,
    "properties": {
      "notebook": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Notebook",
        "type": "string"
      },
      "configfile": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Configfile",
        "type": "string"
      },
      "workdir": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Workdir",
        "type": "string"
      },
      "log_dir": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Log Dir",
        "type": "string"
      },
      "targets": {
        "items": {
          "pattern": "^[A-Za-z0-9_./][A-Za-z0-9_./:+-]*$",
          "type": "string"
        },
        "maxItems": 1000,
        "minItems": 1,
        "title": "Targets",
        "type": "array"
      },
      "job_name": {
        "default": "fungen",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "title": "Job Name",
        "type": "string"
      },
      "queue": {
        "default": "premium",
        "enum": [
          "premium",
          "express"
        ],
        "title": "Queue",
        "type": "string"
      },
      "project": {
        "const": "acc_LOAD",
        "default": "acc_LOAD",
        "title": "Project",
        "type": "string"
      },
      "profile": {
        "const": "canonical_lsf",
        "default": "canonical_lsf",
        "title": "Profile",
        "type": "string"
      },
      "runtime": {
        "const": "canonical",
        "default": "canonical",
        "title": "Runtime",
        "type": "string"
      },
      "controller_cores": {
        "default": 1,
        "maximum": 72,
        "minimum": 1,
        "title": "Controller Cores",
        "type": "integer"
      },
      "workflow_cores": {
        "default": 72,
        "maximum": 512,
        "minimum": 1,
        "title": "Workflow Cores",
        "type": "integer"
      },
      "memory_gb": {
        "default": 40,
        "maximum": 1000,
        "minimum": 32,
        "title": "Memory Gb",
        "type": "integer"
      },
      "jobs": {
        "default": 2000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Jobs",
        "type": "integer"
      },
      "latency_wait": {
        "default": 120,
        "maximum": 3600,
        "minimum": 1,
        "title": "Latency Wait",
        "type": "integer"
      },
      "rerun_triggers": {
        "anyOf": [
          {
            "items": {
              "enum": [
                "mtime",
                "params",
                "input",
                "software-env",
                "code"
              ],
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rerun Triggers"
      },
      "walltime_minutes": {
        "default": 60,
        "maximum": 8640,
        "minimum": 1,
        "title": "Walltime Minutes",
        "type": "integer"
      },
      "phase": {
        "default": "before_run",
        "enum": [
          "before_run",
          "conclusion"
        ],
        "title": "Phase",
        "type": "string"
      }
    },
    "required": [
      "notebook",
      "configfile",
      "workdir",
      "log_dir",
      "targets"
    ],
    "title": "CheckReadiness",
    "type": "object"
  },
  "initiate_run": {
    "additionalProperties": false,
    "properties": {
      "notebook": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Notebook",
        "type": "string"
      },
      "configfile": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Configfile",
        "type": "string"
      },
      "workdir": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Workdir",
        "type": "string"
      },
      "log_dir": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Log Dir",
        "type": "string"
      },
      "targets": {
        "items": {
          "pattern": "^[A-Za-z0-9_./][A-Za-z0-9_./:+-]*$",
          "type": "string"
        },
        "maxItems": 1000,
        "minItems": 1,
        "title": "Targets",
        "type": "array"
      },
      "job_name": {
        "default": "fungen",
        "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
        "title": "Job Name",
        "type": "string"
      },
      "queue": {
        "default": "premium",
        "enum": [
          "premium",
          "express"
        ],
        "title": "Queue",
        "type": "string"
      },
      "project": {
        "const": "acc_LOAD",
        "default": "acc_LOAD",
        "title": "Project",
        "type": "string"
      },
      "profile": {
        "const": "canonical_lsf",
        "default": "canonical_lsf",
        "title": "Profile",
        "type": "string"
      },
      "runtime": {
        "const": "canonical",
        "default": "canonical",
        "title": "Runtime",
        "type": "string"
      },
      "controller_cores": {
        "default": 1,
        "maximum": 72,
        "minimum": 1,
        "title": "Controller Cores",
        "type": "integer"
      },
      "workflow_cores": {
        "default": 72,
        "maximum": 512,
        "minimum": 1,
        "title": "Workflow Cores",
        "type": "integer"
      },
      "memory_gb": {
        "default": 40,
        "maximum": 1000,
        "minimum": 32,
        "title": "Memory Gb",
        "type": "integer"
      },
      "jobs": {
        "default": 2000,
        "maximum": 10000,
        "minimum": 1,
        "title": "Jobs",
        "type": "integer"
      },
      "latency_wait": {
        "default": 120,
        "maximum": 3600,
        "minimum": 1,
        "title": "Latency Wait",
        "type": "integer"
      },
      "rerun_triggers": {
        "anyOf": [
          {
            "items": {
              "enum": [
                "mtime",
                "params",
                "input",
                "software-env",
                "code"
              ],
              "type": "string"
            },
            "maxItems": 5,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Rerun Triggers"
      },
      "walltime_minutes": {
        "default": 8640,
        "maximum": 8640,
        "minimum": 1,
        "title": "Walltime Minutes",
        "type": "integer"
      },
      "depends_on": {
        "items": {
          "pattern": "^[1-9][0-9]{0,19}$",
          "type": "string"
        },
        "maxItems": 32,
        "title": "Depends On",
        "type": "array"
      },
      "defer_readiness": {
        "default": false,
        "title": "Defer Readiness",
        "type": "boolean"
      }
    },
    "required": [
      "notebook",
      "configfile",
      "workdir",
      "log_dir",
      "targets"
    ],
    "title": "InitiateRun",
    "type": "object"
  },
  "control_run": {
    "$defs": {
      "MemoryRemap": {
        "additionalProperties": false,
        "properties": {
          "step": {
            "pattern": "^[A-Za-z][A-Za-z0-9_-]{0,63}$",
            "title": "Step",
            "type": "string"
          },
          "from_gb": {
            "maximum": 1000,
            "minimum": 1,
            "title": "From Gb",
            "type": "integer"
          },
          "to_gb": {
            "maximum": 1000,
            "minimum": 1,
            "title": "To Gb",
            "type": "integer"
          },
          "hard_limit_gb": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Hard Limit Gb"
          }
        },
        "required": [
          "step",
          "from_gb",
          "to_gb"
        ],
        "title": "MemoryRemap",
        "type": "object"
      },
      "QueueMove": {
        "additionalProperties": false,
        "properties": {
          "from_queue": {
            "enum": [
              "premium",
              "express"
            ],
            "title": "From Queue",
            "type": "string"
          },
          "to_queue": {
            "enum": [
              "premium",
              "express"
            ],
            "title": "To Queue",
            "type": "string"
          },
          "limit": {
            "maximum": 20000,
            "minimum": 1,
            "title": "Limit",
            "type": "integer"
          }
        },
        "required": [
          "from_queue",
          "to_queue",
          "limit"
        ],
        "title": "QueueMove",
        "type": "object"
      },
      "Selector": {
        "additionalProperties": false,
        "properties": {
          "kind": {
            "enum": [
              "dead_child_wrappers",
              "pending",
              "step"
            ],
            "title": "Kind",
            "type": "string"
          },
          "queue": {
            "anyOf": [
              {
                "enum": [
                  "premium",
                  "express"
                ],
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Queue"
          },
          "min_pending_minutes": {
            "anyOf": [
              {
                "maximum": 525600,
                "minimum": 0,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Min Pending Minutes"
          },
          "step": {
            "anyOf": [
              {
                "pattern": "^[A-Za-z0-9_][A-Za-z0-9_.:-]{0,127}$",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Step"
          },
          "memory_reservation_gb": {
            "anyOf": [
              {
                "maximum": 1000,
                "minimum": 1,
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Memory Reservation Gb"
          }
        },
        "required": [
          "kind"
        ],
        "title": "Selector",
        "type": "object"
      },
      "SweepSpec": {
        "additionalProperties": false,
        "properties": {
          "memory_remaps": {
            "items": {
              "$ref": "#/$defs/MemoryRemap"
            },
            "maxItems": 1000,
            "title": "Memory Remaps",
            "type": "array"
          },
          "queue_move": {
            "anyOf": [
              {
                "$ref": "#/$defs/QueueMove"
              },
              {
                "type": "null"
              }
            ],
            "default": null
          },
          "interval_seconds": {
            "default": 300,
            "maximum": 86400,
            "minimum": 0,
            "title": "Interval Seconds",
            "type": "integer"
          }
        },
        "title": "SweepSpec",
        "type": "object"
      }
    },
    "additionalProperties": false,
    "properties": {
      "notebook": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Notebook",
        "type": "string"
      },
      "operation": {
        "enum": [
          "kill",
          "switch_queue",
          "modify",
          "sweep"
        ],
        "title": "Operation",
        "type": "string"
      },
      "job_ids": {
        "anyOf": [
          {
            "items": {
              "pattern": "^[1-9][0-9]{0,15}$",
              "type": "string"
            },
            "maxItems": 20000,
            "minItems": 1,
            "type": "array"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Job Ids"
      },
      "selector": {
        "anyOf": [
          {
            "$ref": "#/$defs/Selector"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "queue": {
        "anyOf": [
          {
            "enum": [
              "premium",
              "express"
            ],
            "type": "string"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Queue"
      },
      "memory_reservation_gb": {
        "anyOf": [
          {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Memory Reservation Gb"
      },
      "memory_limit_gb": {
        "anyOf": [
          {
            "maximum": 1000,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Memory Limit Gb"
      },
      "walltime_minutes": {
        "anyOf": [
          {
            "maximum": 8640,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Walltime Minutes"
      },
      "cores": {
        "anyOf": [
          {
            "maximum": 512,
            "minimum": 1,
            "type": "integer"
          },
          {
            "type": "null"
          }
        ],
        "default": null,
        "title": "Cores"
      },
      "sweep": {
        "anyOf": [
          {
            "$ref": "#/$defs/SweepSpec"
          },
          {
            "type": "null"
          }
        ],
        "default": null
      },
      "dead_child_grace_minutes": {
        "default": 10,
        "maximum": 10080,
        "minimum": 0,
        "title": "Dead Child Grace Minutes",
        "type": "integer"
      }
    },
    "required": [
      "notebook",
      "operation"
    ],
    "title": "ControlRun",
    "type": "object"
  },
  "inspect_run": {
    "additionalProperties": false,
    "properties": {
      "notebook": {
        "pattern": "^/[A-Za-z0-9_./:+-]+$",
        "title": "Notebook",
        "type": "string"
      },
      "paths": {
        "items": {
          "pattern": "^/[A-Za-z0-9_./:+-]+$",
          "type": "string"
        },
        "title": "Paths",
        "type": "array"
      },
      "max_bytes": {
        "default": 10000,
        "maximum": 100000,
        "minimum": 1,
        "title": "Max Bytes",
        "type": "integer"
      },
      "dead_child_grace_minutes": {
        "default": 10,
        "maximum": 10080,
        "minimum": 0,
        "title": "Dead Child Grace Minutes",
        "type": "integer"
      }
    },
    "required": [
      "notebook"
    ],
    "title": "InspectRun",
    "type": "object"
  }
}
