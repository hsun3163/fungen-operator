Bootstrap: docker-archive
From: fungen-operator.tar

%environment
    export PATH=/opt/python/bin:/opt/agent/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
    export OLLAMA_HOST=127.0.0.1:11434
    export OLLAMA_CONTEXT_LENGTH=32768
    export OLLAMA_NUM_PARALLEL=1
    export OLLAMA_MAX_LOADED_MODELS=1
    export OLLAMA_FLASH_ATTENTION=1
    export OLLAMA_KV_CACHE_TYPE=q8_0

%runscript
    if [ "$#" -eq 0 ]; then
        exec /opt/python/bin/python3 /opt/fungen-operator/container/fungen.py setup --stay
    fi
    exec /opt/python/bin/python3 /opt/fungen-operator/container/fungen.py "$@"

%test
    /opt/agent/bin/codex --version
    /opt/python/bin/fungen-operator --help
    test -x /bin/ollama
