#!/bin/bash
#BSUB -J fungen-stranger
#BSUB -P acc_LOAD
#BSUB -q premium
#BSUB -n 4
#BSUB -R "rusage[mem=16000] span[hosts=1]"
#BSUB -W 04:00
set -euo pipefail
cd "${LS_SUBCWD:?}"
export PYTHONDONTWRITEBYTECODE=1
options=()
if [[ ${FUNGEN_BUSY_PORT:-0} == 1 ]]; then options+=(--busy-port); fi
if [[ ${FUNGEN_H100:-0} == 1 ]]; then options+=(--h100); fi
python container/acceptance.py "${FUNGEN_SCENARIO:-staged}" \
  --root "${FUNGEN_TRIAL_ROOT:?}" --image "${FUNGEN_IMAGE:?}" \
  --staged "${FUNGEN_STAGED_MODELS:?}" "${options[@]}"
