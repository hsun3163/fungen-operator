{
  "protected": [
    "/path/to/project/results",
    "/path/to/project/output",
    "~/.sanitize-layer"
  ],
  "self_paths": [
    "~/.config/sanitize-layer",
    "/path/to/fungen-operator/data_guard"
  ],
  "agent_mode": {
    "claude": "rewrite",
    "codex": "rewrite"
  },
  "egress": {
