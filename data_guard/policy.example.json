    "max_anonymous_numeric_lines": 50,
    "symbol_files": [
      "/path/to/region_list_with_gene_name_column.tsv"
    ],
    "symbol_column": "gene_name"
  },
  "ollama": {
    "url": "http://127.0.0.1:11435",
    "model": "qwen3.8-flash-next:125b-a6b-q4_K_M",
    "num_ctx": 65536,
    "timeout_sec": 900
  },
  "run": {
    "timeout_sec": 3600
  }
}
