#!/bin/bash
# librarian [--me | --receipt] "<task>"
#
# default: final librarian message -> stdout
# --me:    final librarian message -> latest.md; caller receives only "Done"
# --receipt: local allowlist emits only slot statuses and verification flags
#
# The model endpoint comes from the `codex --oss` launcher: set OLLAMA_HOST to
# pin it, otherwise the launcher finds the Ollama LSF job and tunnels to it.

L=${LIBRARIAN_HOME:-$HOME/sunh14/librarian_agent}
timeout_s=${LIBRARIAN_TIMEOUT:-1800}

# Native Codex writable roots for explicitly authorized manuscript operations.
# Normal retrieval calls keep their existing read-only project boundary.
codex_dirs=()
while [ "$1" = --add-dir ]; do
    if [ -z "$2" ] || [ ! -d "$2" ]; then
        echo 'Librarian failed: --add-dir requires an existing directory'
        exit 2
    fi
    codex_dirs+=(--add-dir "$2")
    shift 2
done

# Deterministic masking is a normal CLI, separate from the model's read-only run.
if [ "$1" = mask ]; then
    shift
    script=$(readlink -f "$0")
    exec python3 "$(dirname "$script")/masking.py" --config "$L/codex/config.toml" "$@"
fi

tag=agent
aud="the coding agent"

if [ "$1" = --me ]; then
    tag=me
    aud="the user"
    shift
elif [ "$1" = --receipt ]; then
    tag=receipt
    aud='the coding agent through a strict local status filter. Return only a JSON object with slots (a map of placeholder IDs to resolved, pending, or needs-human), doc_verified, mask_verified, dictionary_synced, and preserved (four JSON booleans). Optionally include blockers (a map of placeholder IDs to missing-input, source-mismatch, revision-conflict, definition-needed, verification-failed, or unresolved). No Markdown or other prose. Keep all result values, including numeric QC bounds, in your private evidence'
    shift
fi

task=$*
if [ "$1" = --slots ]; then
    tag=slots
    aud="the local masking script, which keeps the response private; return the requested JSON only"
    task=$(cat)
fi

if [ -z "$task" ]; then
    echo 'usage: librarian [--me | --receipt] "<task>" | librarian mask <command>'
    exit 2
fi

id=$(date +%Y%m%d-%H%M%S)-$tag-$$
run=$L/runs/$id

mkdir -p "$run" || { echo "Librarian failed: cannot create $run"; exit 1; }
printf '%s\n' "$task" > "$run/task"

# Jupyter writes to its config and runtime dirs, which the sandbox makes read-only.
export JUPYTER_CONFIG_DIR="$run/.jupyter"
export JUPYTER_RUNTIME_DIR="$run/.jupyter/runtime"
export IPYTHONDIR="$run/.jupyter/ipython"

# stdin from /dev/null: codex exec appends piped stdin to the prompt and would
# otherwise wait on a caller's open pipe.
timeout -k 30 "$timeout_s" \
    env CODEX_HOME="$L/codex" \
    codex "${codex_dirs[@]}" exec --oss \
        --skip-git-repo-check \
        -s workspace-write \
        -C "$run" \
        -o "$run/answer.md" \
        "Your answer goes to $aud. Your run directory is $run. Task: $task" \
        < /dev/null > "$run/log" 2>&1

rc=$?

# With reasoning on, Ollama can return Qwen's reply after a tool call as
# reasoning, so no final message is recorded. Resume the same session with
# reasoning off only to write the final message.
sid=$(sed -n 's/^session id: //p' "$run/log" | head -n 1)
if [ $rc -eq 0 ] && [ ! -s "$run/answer.md" ] && [ -n "$sid" ]; then
    timeout -k 30 "$timeout_s" \
        env CODEX_HOME="$L/codex" \
        codex "${codex_dirs[@]}" exec --oss -c 'model_reasoning_effort="none"' \
            resume --skip-git-repo-check \
            -o "$run/answer.md" \
            "$sid" \
            "Write your final answer to the task now, from the work above. Your answer goes to $aud. Output only the answer." \
            < /dev/null >> "$run/log" 2>&1
    rc=$?
fi

if [ $rc -eq 124 ] || [ $rc -eq 137 ]; then
    echo "Librarian timed out after ${timeout_s}s. Log: $run/log"
    exit 1
fi

if [ $rc -ne 0 ]; then
    echo "Librarian failed: codex exec exited rc=$rc (check the Qwen endpoint). Log: $run/log"
    exit 1
fi

if [ ! -s "$run/answer.md" ]; then
    echo "Librarian failed: no final answer was written. Log: $run/log"
    exit 1
fi

# JupyterLab opens only paths under its root (~), so user-facing paths are
# rewritten to ~/..., through the most specific visible symlink in $HOME.
tilde_sed() {
    printf '%s\n' "s|$HOME/|~/|g"
    for l in "$HOME"/*; do
        [ -L "$l" ] && [ -d "$l" ] || continue
        t=$(readlink -f "$l")
        case $t in "$HOME"/*) continue ;; esac
        printf '%s\t%s\n' "${#t}" "s|$t/|~/${l##*/}/|g;s|$t\$|~/${l##*/}|;s|$t\([^-_.a-zA-Z0-9/]\)|~/${l##*/}\1|g"
    done | sort -rn | cut -f2
}

# Link each ~/ path to JupyterLab (outside code blocks). The user reaches the
# server through a tunnel on 127.0.0.1 at the JUPYTER_PORT exported by the
# Minerva Jupyter launcher.
link_paths() {
    base=${LIBRARIAN_JUPYTER_BASE_URL:-${JUPYTER_PORT:+http://127.0.0.1:$JUPYTER_PORT}}
    if [ -z "$base" ] || [ "${JUPYTER_SERVER_ROOT:-$HOME}" != "$HOME" ]; then
        cat
        return
    fi
    awk -v base="${base%/}/lab/tree/" '
        /^[ \t]*```/ { fence = !fence; print; next }
        fence { print; next }
        {
            out = ""
            while (match($0, /`~\/[^`]+`|~\/[A-Za-z0-9_.\/+-]*[A-Za-z0-9_\/+-]/)) {
                tok = substr($0, RSTART, RLENGTH); pre = substr($0, 1, RSTART - 1)
                path = tok; gsub(/`/, "", path); gsub(/ /, "%20", path)
                out = out pre (pre ~ /\[$/ ? tok : "[" tok "](" base substr(path, 3) ")")
                $0 = substr($0, RSTART + RLENGTH)
            }
            print out $0
        }'
}

if [ "$tag" = receipt ]; then
    # Filter on Minerva before any answer reaches a hosted caller. Unknown
    # fields stay private; malformed allowed fields produce no partial receipt.
    python3 - "$run/answer.md" <<'PY'
import json
from pathlib import Path
import re
import sys

try:
    answer = json.loads(Path(sys.argv[1]).read_text())
    flags = ('doc_verified', 'mask_verified', 'dictionary_synced', 'preserved')
    identifier = re.compile(r'\{\{(?:VALUE|TEXT)-[A-Z2-7]{4}\}\}')
    statuses = {'resolved', 'pending', 'needs-human'}
    reasons = {'missing-input', 'source-mismatch', 'revision-conflict',
               'definition-needed', 'verification-failed', 'unresolved'}
    if not isinstance(answer, dict) or not isinstance(answer.get('slots'), dict):
        raise ValueError()
    slots = answer['slots']
    if any(not identifier.fullmatch(k) or not isinstance(v, str) or v not in statuses
           for k, v in slots.items()):
        raise ValueError()
    if any(type(answer.get(k)) is not bool for k in flags):
        raise ValueError()
    receipt = {'slots': slots, **{k: answer[k] for k in flags}}
    blockers = answer.get('blockers', {})
    if not isinstance(blockers, dict) or any(k not in slots or not isinstance(v, str) or v not in reasons
                                            for k, v in blockers.items()):
        raise ValueError()
    if blockers:
        receipt['blockers'] = blockers
except Exception:
    print('Librarian failed: invalid status receipt; private answer retained.')
    sys.exit(1)
print(json.dumps(receipt, sort_keys=True))
PY
elif [ "$tag" = me ]; then
    tilde_sed > "$run/tilde.sed"
    {
        printf '### %s\n' "$(date '+%F %T')"
        printf '> %s\n\n' "$*"

        if [ -e "$run/analysis.ipynb" ]; then
            printf 'Notebook: `%s`\n\n' "$run/analysis.ipynb"
        fi

        cat "$run/answer.md"
    } | sed -f "$run/tilde.sed" | link_paths > "$L/latest.md.tmp" &&
        mv "$L/latest.md.tmp" "$L/latest.md"

    # Publish to the user's private answers repo, if cloned: README.md is the
    # latest answer, answers/<run id>.md keeps each one. Git output goes to the
    # run log; a sync failure never fails the call.
    repo=${LIBRARIAN_REPO:-$L/repo}
    sync=
    if [ -d "$repo/.git" ]; then
        {
            export GIT_TERMINAL_PROMPT=0
            timeout 120 git -C "$repo" pull -q --rebase &&
                mkdir -p "$repo/answers" &&
                cp "$L/latest.md" "$repo/README.md" &&
                cp "$L/latest.md" "$repo/answers/$id.md" &&
                git -C "$repo" add README.md "answers/$id.md" &&
                git -C "$repo" commit -q -m "Answer $id" &&
                timeout 120 git -C "$repo" push -q
        } >> "$run/log" 2>&1 || sync=" Repo sync failed; see $run/log"
    fi

    echo "Done. The answer is in the user's latest.md.$sync"
else
    cat "$run/answer.md"
fi
