#!/bin/bash
# librarian [--scribe [--check]] [--me | --receipt | --committee RULE] "<task>"
#
# default: final librarian message -> stdout
# --me:    final librarian message -> latest.md; caller receives only "Done"
# --receipt: local allowlist emits only slot statuses and verification flags
#
# The model endpoint comes from the `codex-oss` launcher: set OLLAMA_HOST to
# pin it, otherwise the launcher finds the Ollama LSF job and tunnels to it.

script=$(readlink -f "$0")
here=$(dirname "$script")
L=${LIBRARIAN_HOME:-$HOME/sunh14/librarian_agent}
timeout_s=${LIBRARIAN_TIMEOUT:-1800}
# Pin the librarian to a known-good Codex so the global Codex can be upgraded independently.
export CODEX_REAL_BIN=${LIBRARIAN_CODEX_BIN:-$HOME/sunh14/codex-0155/bin/codex}

# Native Codex writable roots for explicitly authorized manuscript operations.
# Normal retrieval calls keep their existing read-only project boundary.
network_args=()
[ "${LIBRARIAN_NETWORK:-}" = off ] && network_args=(-c sandbox_workspace_write.network_access=false)
codex_dirs=()
while [ "$1" = --add-dir ]; do
    if [ -z "$2" ] || [ ! -d "$2" ]; then
        echo 'Librarian failed: --add-dir requires an existing directory'
        exit 2
    fi
    codex_dirs+=(--add-dir "$2")
    shift 2
done

# Debugging view of one request for the model that sent it: where it stopped, why, the failing line of
# its own script and what each scribe call did, with error text under the release rules.
# Usage: librarian debug RUN   (RUN = the run folder or log path named in a failure message, a run
# folder name under $LIBRARIAN_HOME/runs, or the "Librarian run" ID of a completed request)
if [ "$1" = debug ]; then
    [ $# -eq 2 ] || { echo 'usage: librarian debug RUN'; exit 2; }
    target=$2
    [ -f "$target" ] && target=$(dirname "$target")
    [ -d "$target" ] || target="$L/runs/$2"
    if [ ! -d "$target" ]; then
        target=$(grep -ls "\"run_id\": *\"$2\"" "$L"/runs/*/broker-receipt.json 2>/dev/null | head -1)
        target=${target:+$(dirname "$target")}
    fi
    [ -n "$target" ] && [ -d "$target" ] || { echo "Librarian debug: run $2 was not found under $L/runs"; exit 1; }
    script=$(readlink -f "$0")
    exec python3 "$(dirname "$script")/broker.py" --diagnose "$target"
fi

# Deterministic masking is a normal CLI, separate from the model's read-only run.
if [ "$1" = mask ]; then
    shift
    script=$(readlink -f "$0")
    exec python3 "$(dirname "$script")/masking.py" --config "$L/codex/config.toml" "$@"
fi

tag=agent
aud="the coding agent"

scribe=0
check=0
broker_request=
private_mode=0
response_args=()
committee_rule=
# Private scribe children inherit only this explicit, validated audience setting.
if [ "${LIBRARIAN_SCRIBE_SESSION:-0}" = 1 ] || [ "${LIBRARIAN_NO_PUBLISH:-0}" = 1 ]; then
    committee_rule=${LIBRARIAN_COMMITTEE_RULE:-}
fi
while [ $# -gt 0 ]; do
    case "$1" in
        --broker)
            [ -z "$broker_request" ] && [ -n "$2" ] || { echo 'Librarian failed: --broker requires one request file'; exit 2; }
            broker_request=$2; shift ;;
        --committee)
            [ -n "$2" ] && [ -f "$2" ] || { echo "Librarian failed: committee rule missing"; exit 2; }
            committee_rule=$(readlink -f "$2"); shift ;;
        --scribe) scribe=1 ;;
        --check) check=1 ;;
        --internal) ;; # private child run; same sandbox/privacy contract
        --private)
            private_mode=1
            tag=private
            aud='the local broker only. Your complete response stays private; return exactly the reply format specified in the task'
            ;;
        --me) tag=me; aud="the user" ;;
        --receipt)
            tag=receipt
            aud='the coding agent through a strict local status filter. Return only a JSON object with slots (a map of placeholder IDs to resolved, pending, or needs-human), doc_verified, mask_verified, dictionary_synced, and preserved (four JSON booleans). Optionally include blockers (a map of placeholder IDs to missing-input, source-mismatch, revision-conflict, definition-needed, verification-failed, or unresolved). No Markdown or other prose. Keep all result values, including numeric QC bounds, in your private evidence'
            ;;
        *) break ;;
    esac
    shift
done
if [ -n "$broker_request" ]; then
    export LIBRARIAN_BROKER_POLICY=${LIBRARIAN_BROKER_POLICY:-$L/operator/broker-policy.json}
    if [ "$private_mode" = 1 ] || [ "$scribe" != 0 ] || [ "$check" != 0 ] || [ $# != 0 ]; then
        echo 'Librarian failed: broker mode conflicts with another routing mode or task'; exit 2
    fi
    umask 077
fi
if [ "$private_mode" = 1 ]; then
    if [ "$tag" != private ] || [ "$scribe" != 0 ] || [ "$check" != 0 ] || [ -n "$committee_rule" ]; then
        echo 'Librarian failed: private mode conflicts with another audience or routing mode'; exit 2
    fi
    umask 077
    if [ -n "${LIBRARIAN_OUTPUT_SCHEMA:-}" ]; then
        [ -f "$LIBRARIAN_OUTPUT_SCHEMA" ] || { echo 'Librarian failed: private response schema missing'; exit 2; }
        response_args=(--output-schema "$LIBRARIAN_OUTPUT_SCHEMA")
    fi
fi
if [ "$check" = 1 ] && [ "$scribe" != 1 ]; then
    echo 'Librarian failed: --check requires --scribe'; exit 2
fi

if [ -n "$committee_rule" ]; then
    [ "$tag" = agent ] && [ "$check" = 0 ] || { echo 'Librarian failed: committee audience conflicts with other audience'; exit 2; }
    release=$(python3 - "$committee_rule" <<'RULE'
import json,sys
try:
    r=json.load(open(sys.argv[1]))
    assert r['audience']=='research-committee'
    assert isinstance(r['withheld_quantities'],list) and all(isinstance(v,str) and v for v in r['withheld_quantities'])
    assert isinstance(r['screen_patterns'],list) and all(isinstance(v,str) for v in r['screen_patterns'])
except Exception:
    sys.exit(2)
print(json.dumps(r,ensure_ascii=False))
RULE
    ) || { echo 'Librarian failed: invalid committee release rule'; exit 2; }
    export LIBRARIAN_COMMITTEE_RULE="$committee_rule"
    aud="the research-committee caller under the explicit committee Audience exception. Release every requested finding apart from withheld quantities; write withheld where one was requested. Release rule: $release"
fi

task=$*
[ -n "$broker_request" ] && task="Review the frontier-script request in $broker_request"
if [ -n "$committee_rule" ]; then
    task="Committee audience: answer the caller in full apart from the quantities in this release rule; say withheld where requested. Release rule: $release
$task"
fi
if [ "$1" = --slots ] && [ "$tag" = agent ]; then
    tag=slots
    aud="the local masking script, which keeps the response private; return the requested JSON only"
    task=$(cat)
fi

if [ -z "$task" ]; then
    echo 'usage: librarian [--scribe [--check]] [--me | --receipt | --committee RULE] "<task>" | librarian --broker REQUEST [--me | --receipt | --committee RULE] | librarian mask <command>'
    exit 2
fi

id=$(date +%Y%m%d-%H%M%S)-$tag-$$
run=${LIBRARIAN_RUN_DIR:-$L/runs/$id}
if [ -n "${LIBRARIAN_RUN_DIR:-}" ]; then
    id=$(basename "$run")
    if [ "${LIBRARIAN_NO_PUBLISH:-0}" = 1 ]; then id=$(basename "$(dirname "$run")")-$id; fi
fi

mkdir -p "$run" || { echo "Librarian failed: cannot create $run"; exit 1; }
printf '%s\n' "$task" > "$run/task"

# Hold this lock for the whole librarian session, including resume. Scribes never take it.
if [ "$scribe" = 0 ] && [ -z "$broker_request" ] && [ "${LIBRARIAN_SCRIBE_SESSION:-0}" != 1 ]; then
    exec 9>"$L/librarian.lock"
    flock 9
fi

if [ -n "$broker_request" ]; then
    # Private broker children acquire the native main-model lock themselves.
    # Deliver the reviewed answer through the unchanged audience branches below.
    # Keep the requester's own request beside the run, so `librarian debug` can quote the names it used.
    cp "$broker_request" "$run/request.json" 2>/dev/null || true
    if ! broker_route=$(python3 "$here/live_inventory.py" --policy "$LIBRARIAN_BROKER_POLICY" \
        --request "$broker_request" --output "$run/operator-policy.json" --probe-answer "$run/answer.md" 2> "$run/log"); then
        echo "Librarian failed: the request file or one of its named inputs was not accepted. Check the request format and the input IDs against the header list [code: request-not-accepted]. For details run: librarian debug $(basename "$run")"; exit 1
    fi
    if [ "$broker_route" = analysis ]; then
        LIBRARIAN_BROKER_POLICY="$run/operator-policy.json" \
            LIBRARIAN_BROKER_AUDIENCE="$aud" LIBRARIAN_BROKER_ANSWER="$run/answer.md" \
            python3 "$here/broker.py" "$broker_request" > "$run/broker-receipt.json" 2> "$run/log"
        rc=$?
    else
        rc=0
    fi
    if [ "$rc" != 0 ]; then
        # Say in plain words why the request stopped and what to do next: a fixed sentence per reason code,
        # plus the error type and line for a crashed script; never any data.
        why=$(python3 - "$run/broker-receipt.json" <<'WHY' 2>/dev/null
import json,sys
plain={
 'execution-failed':'the script stopped with an error{where}. Correct the script and send it again',
 'result-columns':'the header the script wrote differs from output.columns in the request. Make the two match',
 'result-shape':'the rows the script wrote have differing numbers of cells. Write one rectangular table',
 'script-hash':'the script file changed after its sha256 was taken. Recompute the hash and send again',
 'sandbox-unavailable':'this machine cannot start the sandbox. Send the request from another cluster node',
 'binding-disagreement':'the scribes chose different inputs or parameters. Name the input and each parameter value plainly in the question',
 'binding-unresolved':'the scribes could not tell which input or parameter the question means. Name them plainly in the question',
 'staff-declined':'the scribe declined to start this script. Check that the script matches the question and the named inputs',
 'scribe-unavailable':'a scribe model server could not be reached. Try again in a minute',
 'main-tunnel-unavailable':'the main librarian model could not be reached. Try again in a minute',
 'TimeoutError':'a step ran past its time limit. Reduce the work in one request or try again',
 'reply-unreadable':'a scribe reply could not be read after three sends. Try again',
 'needs-local-review':'the answer was withheld at review under the audience rule. Ask Hao to run it with librarian --me for the full result',
 'optional-withhold':'the answer was withheld at the second look. Ask Hao to run it with librarian --me for the full result',
}
try:
    r=json.load(open(sys.argv[1])); code=str(r.get('failure_code') or r.get('status') or 'no receipt'); e=r.get('execution_error') or {}
    where=(' ('+str(e.get('exception'))+' at script line '+str(e.get('script_line'))+')') if e else ''
    print(plain.get(code,'reason code '+code).format(where=where)+' [code: '+code+']')
except Exception:
    print('the request stopped before a receipt was written [code: no receipt]')
WHY
)
        echo "Librarian failed: ${why:-the request stopped before a receipt was written}. For details run: librarian debug $(basename "$run")"; exit 1
    fi
    python3 - "$run/broker-receipt.json" <<'DELIVERY' >&2
import json,sys
r=json.load(open(sys.argv[1]))
if r.get('service')=='librarian':
    if r.get('rephrase_request'): print(r['rephrase_request'])
    delivery=r.get('google',{})
    print('Librarian run: '+r['run_id']+'; Google: '+delivery.get('status','retained')+(' ('+delivery['reason']+')' if 'reason' in delivery else ''))
DELIVERY
elif [ "$scribe" = 1 ]; then
    export LIBRARIAN_SCRIBE_ADD_DIRS
    LIBRARIAN_SCRIBE_ADD_DIRS=$(python3 -c 'import json,sys; print(json.dumps(sys.argv[1:]))' "${codex_dirs[@]}")
    python3 "$here/scribe_support.py" route "$run" "$check" "$tag" >> "$run/log" 2>&1
    rc=$?
    if [ -f "$run/backend" ] && [ "$(cat "$run/backend")" = librarian ]; then
        if [ "$check" = 1 ]; then
            echo 'No healthy scribe; running A and B sequentially on the main librarian.' >&2
        else
            echo 'No healthy scribe; falling back to the main librarian.' >&2
        fi
    fi
    if [ "$rc" != 0 ]; then
        echo "Librarian failed: scribe routing or session failed. Log: $run/log"; exit 1
    fi
else

# Jupyter writes to its config and runtime dirs, which the sandbox makes read-only.
export JUPYTER_CONFIG_DIR="$run/.jupyter"
export JUPYTER_RUNTIME_DIR="$run/.jupyter/runtime"
export IPYTHONDIR="$run/.jupyter/ipython"

session_instruction="Before answering, execute pwd in this run directory to verify commands work."
[ "$private_mode" = 1 ] && session_instruction="The task contains private binding or review evidence. No command is needed when that evidence is sufficient."

# stdin from /dev/null: codex exec appends piped stdin to the prompt and would
# otherwise wait on a caller's open pipe.
timeout -k 30 "$timeout_s" \
    env CODEX_HOME="$L/codex" \
    codex-oss "${codex_dirs[@]}" exec --oss --json "${network_args[@]}" \
        "${response_args[@]}" \
        --skip-git-repo-check \
        -s workspace-write \
        -C "$run" \
        -o "$run/answer.md" \
        "Your answer goes to $aud. Your run directory is $run. ${session_instruction} Task: $task" \
        < /dev/null > "$run/log" 2>&1

rc=$?

# With reasoning on, Ollama can return Qwen's reply after a tool call as
# reasoning, so no final message is recorded. Resume the same session with
# reasoning off only to write the final message.
# Detect execution failures even when Codex returns rc=0 and writes a plausible answer.
reason=$(python3 "$here/scribe_support.py" log "$run/log"); log_rc=$?
sid=$(python3 "$here/scribe_support.py" session "$run/log")
# Guard rails guide the agent; they block only work that has no evidence behind it.
# Mistakes the agent recovered from stand as notes. When its last tool call failed,
# hand it the correction and let it redo the step, at most twice.
guided=0
while [ $log_rc != 0 ] && [ "$reason" = 'ended on a failed tool call' ] && [ -n "$sid" ] \
        && [ "$private_mode" != 1 ] && [ $guided -lt 2 ]; do
    guided=$((guided + 1))
    hint=$(python3 "$here/scribe_support.py" guidance "$run/log")
    timeout -k 30 "$timeout_s" \
        env CODEX_HOME="$L/codex" \
        codex-oss "${codex_dirs[@]}" exec --oss --json "${network_args[@]}" -s workspace-write \
            resume "${response_args[@]}" --skip-git-repo-check \
            -o "$run/answer.md" \
            "$sid" \
            "Your last tool call failed. $hint Redo that step with one command, then write your final answer to the task from the work above. Your answer goes to $aud." \
            < /dev/null >> "$run/log" 2>&1
    rc=$?
    reason=$(python3 "$here/scribe_support.py" log "$run/log"); log_rc=$?
done
if [ $log_rc != 0 ] && [ "$private_mode" != 1 ]; then
    echo "Librarian failed: $reason. Log: $run/log"; exit 1
fi
notes=$(python3 "$here/scribe_support.py" notes "$run/log")
[ -n "$notes" ] && printf 'recovered tool mistakes: %s; guided retries: %s\n' "$notes" "$guided" > "$run/session-notes.txt"
if [ $rc -eq 0 ] && [ ! -s "$run/answer.md" ] && [ -n "$sid" ]; then
    timeout -k 30 "$timeout_s" \
        env CODEX_HOME="$L/codex" \
        codex-oss "${codex_dirs[@]}" exec --oss --json "${network_args[@]}" -s workspace-write -c 'model_reasoning_effort="none"' \
            resume "${response_args[@]}" --skip-git-repo-check \
            -o "$run/answer.md" \
            "$sid" \
            "Write your final answer to the task now, from the work above. Your answer goes to $aud. Output only the answer." \
            < /dev/null >> "$run/log" 2>&1
    rc=$?
    reason=$(python3 "$here/scribe_support.py" log "$run/log")
    if [ $? != 0 ] && [ "$private_mode" != 1 ]; then
        echo "Librarian failed: $reason. Log: $run/log"; exit 1
    fi
fi
fi # direct backend versus scribe routing

# Private final replies are validated by the broker; session diagnostics stay local.
if [ "$private_mode" = 1 ]; then
    python3 - "$run/session-audit.json" "$rc" "$reason" <<'AUDIT'
import json,sys
from pathlib import Path
Path(sys.argv[1]).write_text(json.dumps(dict(exit_code=int(sys.argv[2]), note=sys.argv[3] or None))+'\n')
AUDIT
    [ -s "$run/answer.md" ] && exit 0
fi

if [ $rc -eq 124 ] || [ $rc -eq 137 ]; then
    echo "Librarian failed: timed out after ${timeout_s}s. Log: $run/log"
    exit 1
fi

if [ $rc -ne 0 ]; then
    echo "Librarian failed: codex exec exited rc=$rc (check the Qwen endpoint). Log: $run/log"
    exit 1
fi

if [ ! -s "$run/answer.md" ]; then
    echo "Librarian failed: no final answer was written. Log: $run/log"
    exit 1
fi

# Broker children have no publication side effects or direct caller response.
if [ "$tag" = private ]; then
    exit 0
fi

# JupyterLab opens only paths under its root (~), so user-facing paths are
# rewritten to ~/..., through the most specific visible symlink in $HOME.
tilde_sed() {
    printf '%s\n' "s|$HOME/|~/|g"
    for l in "$HOME"/*; do
        [ -L "$l" ] && [ -d "$l" ] || continue
        t=$(readlink -f "$l")
        case $t in "$HOME"/*) continue ;; esac
        printf '%s\t%s\n' "${#t}" "s|$t/|~/${l##*/}/|g;s|$t\$|~/${l##*/}|;s|$t\([^-_.a-zA-Z0-9/]\)|~/${l##*/}\1|g"
    done | sort -rn | cut -f2
}

# Link each ~/ path to JupyterLab (outside code blocks). The user reaches the
# server through a tunnel on 127.0.0.1 at the JUPYTER_PORT exported by the
# Minerva Jupyter launcher.
link_paths() {
    base=${LIBRARIAN_JUPYTER_BASE_URL:-${JUPYTER_PORT:+http://127.0.0.1:$JUPYTER_PORT}}
    if [ -z "$base" ] || [ "${JUPYTER_SERVER_ROOT:-$HOME}" != "$HOME" ]; then
        cat
        return
    fi
    awk -v base="${base%/}/lab/tree/" '
        /^[ \t]*```/ { fence = !fence; print; next }
        fence { print; next }
        {
            out = ""
            while (match($0, /`~\/[^`]+`|~\/[A-Za-z0-9_.\/+-]*[A-Za-z0-9_\/+-]/)) {
                tok = substr($0, RSTART, RLENGTH); pre = substr($0, 1, RSTART - 1)
                path = tok; gsub(/`/, "", path); gsub(/ /, "%20", path)
                out = out pre (pre ~ /\[$/ ? tok : "[" tok "](" base substr(path, 3) ")")
                $0 = substr($0, RSTART + RLENGTH)
            }
            print out $0
        }'
}

if [ -n "$committee_rule" ]; then
    # Committee calls never publish private raw answers to latest.md or the answer repo.
    cat "$run/answer.md"
    exit 0
fi

if [ "${LIBRARIAN_NO_PUBLISH:-0}" = 1 ]; then
    mkdir -p "$L/answers"
    tilde_sed > "$run/tilde.sed"
    sed -f "$run/tilde.sed" "$run/answer.md" | link_paths > "$L/answers/$id.md" || exit 1
    if [ "$tag" != receipt ] && [ "$tag" != slots ]; then
        exec 8>"$L/answers.lock"; flock 8
        { printf '### %s (independent session; preliminary)\n' "$id"; cat "$L/answers/$id.md"; printf '\n'; } >> "$L/latest.md" || exit 1
    fi
    exit 0
fi

if [ "$tag" = receipt ]; then
    # Filter on Minerva before any answer reaches a hosted caller. Unknown
    # fields stay private; malformed allowed fields produce no partial receipt.
    python3 - "$run/answer.md" <<'PY'
import json
from pathlib import Path
import re
import sys

try:
    answer = json.loads(Path(sys.argv[1]).read_text())
    flags = ('doc_verified', 'mask_verified', 'dictionary_synced', 'preserved')
    identifier = re.compile(r'\{\{(?:VALUE|TEXT)-[A-Z2-7]{4}\}\}')
    statuses = {'resolved', 'pending', 'needs-human'}
    reasons = {'missing-input', 'source-mismatch', 'revision-conflict',
               'definition-needed', 'verification-failed', 'unresolved'}
    if not isinstance(answer, dict) or not isinstance(answer.get('slots'), dict):
        raise ValueError()
    slots = answer['slots']
    if any(not identifier.fullmatch(k) or not isinstance(v, str) or v not in statuses
           for k, v in slots.items()):
        raise ValueError()
    if any(type(answer.get(k)) is not bool for k in flags):
        raise ValueError()
    receipt = {'slots': slots, **{k: answer[k] for k in flags}}
    blockers = answer.get('blockers', {})
    if not isinstance(blockers, dict) or any(k not in slots or not isinstance(v, str) or v not in reasons
                                            for k, v in blockers.items()):
        raise ValueError()
    if blockers:
        receipt['blockers'] = blockers
    if 'run_id' in answer:
        if not re.fullmatch(r'run-[0-9a-f]{32}', answer['run_id']): raise ValueError('run-id')
        receipt['run_id']=answer['run_id']
    if 'delivery' in answer:
        delivery=answer['delivery']
        if not isinstance(delivery,dict) or delivery.get('status') not in ('sent','local-retained'): raise ValueError('delivery')
        clean={'status':delivery['status']}
        if 'reason' in delivery:
            if not re.fullmatch(r'[A-Za-z0-9-]{1,128}',delivery['reason']): raise ValueError('delivery-reason')
            clean['reason']=delivery['reason']
        receipt['delivery']=clean
except Exception:
    print('Librarian failed: invalid status receipt; private answer retained.')
    sys.exit(1)
print(json.dumps(receipt, sort_keys=True))
PY
elif [ "$tag" = me ]; then
    mkdir -p "$L/answers"
    # Serialize latest.md and optional private repo sync for concurrent scribe callers.
    exec 8>"$L/answers.lock"
    flock 8
    tilde_sed > "$run/tilde.sed"
    {
        printf '### %s\n' "$(date '+%F %T')"
        printf '> %s\n\n' "$*"

        if [ -e "$run/analysis.ipynb" ]; then
            printf 'Notebook: `%s`\n\n' "$run/analysis.ipynb"
        fi

        cat "$run/answer.md"
    } | sed -f "$run/tilde.sed" | link_paths > "$L/answers/$id.md" || exit 1
    if [ "$scribe" = 1 ]; then
        cat "$L/answers/$id.md" >> "$L/latest.md" || exit 1
        printf '\n' >> "$L/latest.md" || exit 1
    else
        cp "$L/answers/$id.md" "$L/latest.md.tmp" && mv "$L/latest.md.tmp" "$L/latest.md" || exit 1
    fi

    # Publish to the user's private answers repo, if cloned: README.md is the
    # latest answer, answers/<run id>.md keeps each one. Git output goes to the
    # run log; a sync failure never fails the call.
    repo=${LIBRARIAN_REPO:-$L/repo}
    sync=
    if [ -d "$repo/.git" ]; then
        {
            export GIT_TERMINAL_PROMPT=0
            timeout 120 git -C "$repo" pull -q --rebase &&
                mkdir -p "$repo/answers" &&
                cp "$L/latest.md" "$repo/README.md" &&
                cp "$L/answers/$id.md" "$repo/answers/$id.md" &&
                git -C "$repo" add README.md "answers/$id.md" &&
                git -C "$repo" commit -q -m "Answer $id" &&
                timeout 120 git -C "$repo" push -q
        } >> "$run/log" 2>&1 || sync=" Repo sync failed; see $run/log"
    fi

    echo "Done. The answer is in the user's latest.md.$sync"
else
    if [ "$scribe" = 1 ]; then
        mkdir -p "$L/answers"
        exec 8>"$L/answers.lock"; flock 8
        cp "$run/answer.md" "$L/answers/$id.md" || exit 1
        { printf '### %s\n' "$id"; cat "$L/answers/$id.md"; printf '\n'; } >> "$L/latest.md" || exit 1
    fi
    cat "$run/answer.md"
fi
